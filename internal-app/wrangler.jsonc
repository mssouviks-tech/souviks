{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "souviks-internal",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-07",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "d1_databases": [
    { "binding": "DB", "database_name": "souviks-internal", "database_id": "REPLACE_WITH_D1_DATABASE_ID" }
  ]
}
